# ==============================================================================
# MOZART SCHOOL OF WESTERN CLASSICAL MUSIC - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER ENVIRONMENT (Exposed to the public client in Vite)
# Note: ONLY public/anon credentials belong here. NEVER place service role keys here!
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Key (safe for browsers; protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Cloudflare Turnstile Site Key (Client-side invisible or managed widget)
# Create a free Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...your-turnstile-site-key


# ------------------------------------------------------------------------------
# 2. SERVER & EDGE FUNCTION ENVIRONMENT (Kept strictly private on Supabase)
# Set these secrets in Supabase CLI or Dashboard:
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... RESEND_API_KEY=...
# ------------------------------------------------------------------------------
# Supabase internal URL (automatically provided in hosted Edge Functions)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Privileged Service-Role Key (Bypasses RLS to record leads atomically)
# WARNING: NEVER prefix with VITE_ or expose to browser clients!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Cloudflare Turnstile Secret Key (Used by submit-enquiry to verify tokens)
TURNSTILE_SECRET_KEY=0x4AAAAAA...your-turnstile-secret-key

# Transactional Email Provider (Resend.com API Key)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address (Requires domain verification in Resend)
FROM_EMAIL=Mozart School <enquiries@your-verified-domain.com>

# School Administrator Recipient for Internal Alerts
OWNER_EMAIL=srinivaschetty@gmail.com

# Allowed CORS Origins (comma-separated list of deployed origins)
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173,https://mozartmusic.org
